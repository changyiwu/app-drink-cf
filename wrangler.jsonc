{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "app-drink-cf",
	"main": "./worker/index.js",
	"compatibility_date": "2026-09-23",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "app-drink-cf",
			"database_id": "6b2bb7d9-899e-46e6-9b2d-ea58774578e6"
		}
	]
}